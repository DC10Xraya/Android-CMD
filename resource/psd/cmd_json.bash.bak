#resource/cmd_json.bash
cmd_json() {
    # 显示帮助
    if [[ "$1" == "-h" || "$1" == "--help" ]]; then
        cecho -b "用法: JSON [参数] <目标json所在路径>"
        cecho "JSON -w (交互模式, 粘贴内容后按 Ctrl+D 校验)"
        cecho -b "参数:"
        cecho "  -w           交互模式, 无需指定文件, 最好指定格式, 否则两种都判断"
        cecho "  -5           强制指定 JSON5 (默认根据后缀 .json5 识别)"
        cecho "  -0           强制指定标准 JSON (默认根据后缀 .json 识别)"
        cecho "  -s <解析器>  强制指定解析器 (jq/py/bash), 默认自动选择"
        err "警告: 使用bash解析为实验性内容, 只做基本检测"
        cecho -b "关于使用bash解析的说明:"
        cecho "# 只做语法层面的基本检查, 不保证 100% 符合 RFC 8259"
        cecho "# 能检测: 括号/引号平衡、键值结构、逗号位置、数字格式、字面量拼写等"
        cecho "# 不检测: UTF-8 编码、\u 转义合法性、重复键、NaN/Infinity 等细节"
        return 0
    fi

    local interactive=0
    local force_type=""      # "json" 或 "json5"
    local force_parser=""    # "jq" 或 "py" 或 "bash"
    local file_path=""

    # 参数解析
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -w)
                interactive=1
                shift
                ;;
            -5)
                force_type="json5"
                shift
                ;;
            -0)
                force_type="json"
                shift
                ;;
            -s)
                if [[ -z "$2" ]]; then
                    err "选项 -s 需要指定解析器 (jq/py/bash)"
                    return 1
                fi
                case "$2" in
                    jq|py|bash) force_parser="$2" ;;
                    *)
                        err "无效解析器: $2, 可选 jq/py/bash"
                        return 1
                        ;;
                esac
                shift 2
                ;;
            -*)
                err "未知选项: $1"
                return 1
                ;;
            *)
                if [[ -n "$file_path" ]]; then
                    err "只能指定一个文件"
                    return 1
                fi
                file_path="$1"
                shift
                ;;
        esac
    done

    # 交互模式
    if [[ $interactive -eq 1 ]]; then
        if [[ -n "$file_path" ]]; then
            err "-w 模式不能指定文件"
            return 1
        fi
        local prompt_msg="请输入 JSON 或 JSON5 内容 (按 Ctrl+D 结束):"
        if [[ "$force_type" == "json" ]]; then
            prompt_msg="请输入 JSON 内容 (按 Ctrl+D 结束):"
        elif [[ "$force_type" == "json5" ]]; then
            prompt_msg="请输入 JSON5 内容 (按 Ctrl+D 结束):"
        fi
        cecho "$prompt_msg"
        local content
        content=$(cat)
        if [[ -z "$content" ]]; then
            err "未输入任何内容"
            return 1
        fi

        if [[ -n "$force_type" ]]; then
            _validate_and_print "$content" "$force_type" "$force_parser"
            return $?
        else
            _print_label "JSON"
            _validate_and_print "$content" "json" "$force_parser"
            local json_ret=$?
            _print_label "JSON5"
            _validate_and_print "$content" "json5" "$force_parser"
            local json5_ret=$?
            if [[ $json_ret -eq 0 || $json5_ret -eq 0 ]]; then
                return 0
            else
                return 1
            fi
        fi
        return
    fi

    # 文件模式
    if [[ -z "$file_path" ]]; then
        err "缺少目标文件路径 (使用 -h 查看帮助)"
        return 1
    fi

    if [[ ! -f "$file_path" ]]; then
        err "文件不存在: $file_path"
        return 1
    fi
    if [[ ! -r "$file_path" ]]; then
        err "文件不可读: $file_path"
        return 1
    fi

    local content
    content=$("$_CAT" "$file_path" 2>/dev/null)
    if [[ -z "$content" && -s "$file_path" ]]; then
        err "无法读取文件内容"
        return 1
    fi

    local actual_type="$force_type"
    if [[ -z "$actual_type" ]]; then
        local ext="${file_path##*.}"
        ext=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
        if [[ "$ext" == "json5" ]]; then
            actual_type="json5"
        elif [[ "$ext" == "json" ]]; then
            actual_type="json"
        else
            actual_type="json"
        fi
    fi

    _validate_and_print "$content" "$actual_type" "$force_parser"
    return $?
}

# ---------- 解析器探测 ----------

# 缓存(避免重复探测)
_JQ_BIN=""
_PY_BIN=""
_PARSER_PROBED=0

# 探测 jq 与 python 的可用路径, 结果写入 _JQ_BIN / _PY_BIN(空串表示未找到)
_probe_parsers() {
    [[ $_PARSER_PROBED -eq 1 ]] && return
    _PARSER_PROBED=1

    # ---- jq ----
    local cand
    for cand in \
        "$(command -v jq 2>/dev/null)" \
        /usr/bin/jq \
        /usr/local/bin/jq \
        /opt/homebrew/bin/jq \
        /opt/local/bin/jq \
        "$HOME/.local/bin/jq" \
        "$HOME/bin/jq"
    do
        if [[ -n "$cand" && -x "$cand" ]]; then
            _JQ_BIN="$cand"
            break
        fi
    done

    # ---- python ----
    # 优先 python3(多数系统上 python 已不指向 py3), 再 python, 最后 Windows 的 py
    for cand in \
        "$(command -v python3 2>/dev/null)" \
        /usr/bin/python3 \
        /usr/local/bin/python3 \
        /opt/homebrew/bin/python3 \
        /opt/local/bin/python3 \
        "$HOME/.local/bin/python3" \
        /usr/bin/python \
        /usr/local/bin/python \
        /opt/homebrew/bin/python \
        "$(command -v python 2>/dev/null)" \
        "$(command -v py 2>/dev/null)"
    do
        if [[ -n "$cand" && -x "$cand" ]]; then
            # 简单确认能跑起来(避免 Windows 商店的假 python3.exe 占位)
            if "$cand" -c "import sys, json" >/dev/null 2>&1; then
                _PY_BIN="$cand"
                break
            fi
        fi
    done
}

# 检查指定解析器是否可用(供 -s 强制时给出明确提示)
_parser_available() {
    _probe_parsers
    case "$1" in
        jq)   [[ -n "$_JQ_BIN" ]] ;;
        py)   [[ -n "$_PY_BIN" ]] ;;
        bash) return 0 ;;
        *)    return 1 ;;
    esac
}

# ---------- 内部函数 ----------

# 打印标签(用于交互模式未指定类型时)
_print_label() {
    local label="$1"
    echo "--- $label 检测结果 ---"
}

# 封装校验和输出(有效绿色, 无效红色)
_validate_and_print() {
    local content="$1"
    local type="$2"
    local parser="$3"

    local result=0
    local output
    output=$(_validate_json_content "$content" "$type" "$parser" 2>&1)
    result=$?

    if [[ $result -eq 0 ]]; then
        cecho -c 92 "有效"
    else
        err "$output"
    fi
    return $result
}

# 核心校验函数(只输出错误信息到 stdout, 返回状态码)
_validate_json_content() {
    local content="$1"
    local force_type="$2"
    local force_parser="$3"

    local json_type="$force_type"
    [[ -z "$json_type" ]] && json_type="json"

    # 预处理 JSON5 -> 去除注释和尾随逗号
    local clean_content="$content"
    if [[ "$json_type" == "json5" ]]; then
        clean_content=$(_json5_strip "$content")
    fi

    _probe_parsers

    # 确定尝试顺序
    local parsers=()
    if [[ -n "$force_parser" ]]; then
        parsers=("$force_parser")
    else
        parsers=("jq" "py" "bash")
    fi

    local last_error=""
    local tried_any=0
    for parser in "${parsers[@]}"; do
        local result=0
        local err_msg=""
        case "$parser" in
            jq)
                if [[ -n "$_JQ_BIN" ]]; then
                    err_msg=$(printf '%s' "$clean_content" | "$_JQ_BIN" . 2>&1 >/dev/null)
                    result=$?
                    tried_any=1
                else
                    err_msg="jq 命令未安装(已尝试常见路径)"
                    result=127
                fi
                ;;
            py)
                if [[ -n "$_PY_BIN" ]]; then
                    err_msg=$(printf '%s' "$clean_content" | "$_PY_BIN" -c "import sys, json; json.load(sys.stdin)" 2>&1)
                    result=$?
                    tried_any=1
                else
                    err_msg="python 命令未安装(已尝试 python3/python/py 常见路径)"
                    result=127
                fi
                ;;
            bash)
                err_msg=$(_validate_json_bash "$clean_content")
                result=$?
                tried_any=1
                ;;
            *)
                err_msg="未知解析器"
                result=1
                tried_any=1
                ;;
        esac

        if [[ $result -eq 0 ]]; then
            return 0
        fi

        # 只有真正跑过的解析器, 其错误才作为候选
        if [[ $result -ne 127 ]]; then
            last_error=$(printf '%s' "$err_msg" | head -1 | tr -d '\n')
        elif [[ -z "$last_error" ]]; then
            last_error=$(printf '%s' "$err_msg" | head -1 | tr -d '\n')
        fi
    done

    if [[ $tried_any -eq 0 ]]; then
        echo "无可用解析器 (jq / python / bash 都不可用)"
        return 1
    fi

    if [[ -n "$last_error" ]]; then
        echo "$last_error"
    else
        echo "无效 (原因未知)"
    fi
    return 1
}

# JSON5 预处理: 去 // 行注释、/* */ 块注释、对象/数组尾随逗号
# 使用 awk 保证不误伤字符串内部的注释符号与逗号
_json5_strip() {
    local content="$1"
    if command -v awk >/dev/null 2>&1; then
        printf '%s' "$content" | awk '
        BEGIN { in_str=0; esc=0; in_lc=0; in_bc=0 }
        {
            line = $0
            out = ""
            i = 1
            n = length(line)
            # 行注释只在非字符串时开始, 跨行不延续(本行结束即止)
            if (in_bc) {
                # 查找 */
                while (i <= n) {
                    if (substr(line, i, 2) == "*/") { in_bc=0; i+=2; break }
                    i++
                }
            }
            while (i <= n) {
                c = substr(line, i, 1)
                c2 = substr(line, i, 2)
                if (in_str) {
                    out = out c
                    if (esc) { esc=0 }
                    else if (c == "\\") { esc=1 }
                    else if (c == "\"") { in_str=0 }
                    i++
                    continue
                }
                if (in_bc) {
                    if (c2 == "*/") { in_bc=0; i+=2; continue }
                    i++
                    continue
                }
                if (c2 == "//") { break }           # 行注释, 跳过本行剩余
                if (c2 == "/*") { in_bc=1; i+=2; continue }
                if (c == "\"") { in_str=1; out = out c; i++; continue }
                if (c == "'"'"'") { in_str=1; str_ch="'"'"'"; out = out c; i++; continue }
                out = out c
                i++
            }
            print out
        }
        ' | awk '
        # 处理尾随逗号: , 后紧跟 (可选空白) 再 } 或 ] 时删掉逗号
        {
            lines[NR] = $0
        }
        END {
            for (k = 1; k <= NR; k++) {
                s = lines[k]
                # 反复替换 ,\s*([}\]]) -> \1
                while (match(s, /,[ \t]*[}\]]/)) {
                    s = substr(s, 1, RSTART-1) substr(s, RSTART+1, RLENGTH-1)
                }
                print s
            }
        }
        '
    else
        # 没有 awk 时退回到朴素的 sed(可能误伤字符串内容)
        printf '%s' "$content" \
            | $_SED -E 's|//.*$||g' 2>/dev/null \
            | $_SED -E ':a; s|/\*[^*]*\*/||g; ta' 2>/dev/null \
            | $_SED -E 's/,[[:space:]]*([}\]])/\1/g' 2>/dev/null
    fi
}

# ---------- 纯 Bash JSON 校验(递归下降, 实验性) ----------
# 只做语法层面的基本检查, 不保证 100% 符合 RFC 8259
# 能检测: 括号/引号平衡、键值结构、逗号位置、数字格式、字面量拼写等
# 不检测: UTF-8 编码、\u 转义合法性、重复键、NaN/Infinity 等细节

_validate_json_bash() {
    local json="$1"

    _JB_JSON="$json"
    _JB_LEN=${#json}
    _JB_POS=0
    _JB_ERR=""

    if ! _jb_parse_value; then
        printf '%s\n' "$_JB_ERR"
        return 1
    fi
    _jb_skip_ws
    if (( _JB_POS < _JB_LEN )); then
        printf '位置 %d: 多余的字符 %q\n' "$_JB_POS" "${_JB_JSON:_JB_POS:1}"
        return 1
    fi
    return 0
}

_jb_fail() {
    [[ -n "$_JB_ERR" ]] && return
    _JB_ERR="位置 $_JB_POS: $1"
}

_jb_skip_ws() {
    while (( _JB_POS < _JB_LEN )); do
        case "${_JB_JSON:_JB_POS:1}" in
            ' '|$'\t'|$'\n'|$'\r') _JB_POS=$((_JB_POS + 1)) ;;
            *) break ;;
        esac
    done
}

_jb_parse_value() {
    _jb_skip_ws
    if (( _JB_POS >= _JB_LEN )); then
        _jb_fail "意外的输入结束, 期望一个值"
        return 1
    fi
    local c="${_JB_JSON:_JB_POS:1}"
    case "$c" in
        '{') _jb_parse_object ;;
        '[') _jb_parse_array ;;
        '"') _jb_parse_string ;;
        't') _jb_parse_literal true ;;
        'f') _jb_parse_literal false ;;
        'n') _jb_parse_literal null ;;
        -|[0-9]) _jb_parse_number ;;
        *)
            _jb_fail "意外的字符 '$c'"
            return 1
            ;;
    esac
}

_jb_parse_literal() {
    local kw="$1"
    if [[ "${_JB_JSON:_JB_POS:${#kw}}" == "$kw" ]]; then
        _JB_POS=$((_JB_POS + ${#kw}))
        return 0
    fi
    _jb_fail "无效的字面量(期望 $kw)"
    return 1
}

_jb_parse_string() {
    _JB_POS=$((_JB_POS + 1))
    while (( _JB_POS < _JB_LEN )); do
        local c="${_JB_JSON:_JB_POS:1}"
        if [[ "$c" == '\' ]]; then
            if (( _JB_POS + 1 >= _JB_LEN )); then
                _jb_fail "字符串以孤立的反斜杠结尾"
                return 1
            fi
            _JB_POS=$((_JB_POS + 2))
            continue
        fi
        if [[ "$c" == '"' ]]; then
            _JB_POS=$((_JB_POS + 1))
            return 0
        fi
        _JB_POS=$((_JB_POS + 1))
    done
    _jb_fail "字符串未闭合"
    return 1
}

_jb_parse_number() {
    [[ "${_JB_JSON:_JB_POS:1}" == '-' ]] && _JB_POS=$((_JB_POS + 1))

    local c="${_JB_JSON:_JB_POS:1}"
    if [[ "$c" == '0' ]]; then
        _JB_POS=$((_JB_POS + 1))
    elif [[ "$c" =~ [1-9] ]]; then
        while [[ "${_JB_JSON:_JB_POS:1}" =~ [0-9] ]]; do
            _JB_POS=$((_JB_POS + 1))
        done
    else
        _jb_fail "无效的数字起始字符 '$c'"
        return 1
    fi

    if [[ "${_JB_JSON:_JB_POS:1}" == '.' ]]; then
        _JB_POS=$((_JB_POS + 1))
        if ! [[ "${_JB_JSON:_JB_POS:1}" =~ [0-9] ]]; then
            _jb_fail "小数点后应当有数字"
            return 1
        fi
        while [[ "${_JB_JSON:_JB_POS:1}" =~ [0-9] ]]; do
            _JB_POS=$((_JB_POS + 1))
        done
    fi

    if [[ "${_JB_JSON:_JB_POS:1}" == 'e' || "${_JB_JSON:_JB_POS:1}" == 'E' ]]; then
        _JB_POS=$((_JB_POS + 1))
        if [[ "${_JB_JSON:_JB_POS:1}" == '+' || "${_JB_JSON:_JB_POS:1}" == '-' ]]; then
            _JB_POS=$((_JB_POS + 1))
        fi
        if ! [[ "${_JB_JSON:_JB_POS:1}" =~ [0-9] ]]; then
            _jb_fail "指数部分应当有数字"
            return 1
        fi
        while [[ "${_JB_JSON:_JB_POS:1}" =~ [0-9] ]]; do
            _JB_POS=$((_JB_POS + 1))
        done
    fi
    return 0
}

_jb_parse_object() {
    _JB_POS=$((_JB_POS + 1))
    _jb_skip_ws
    if [[ "${_JB_JSON:_JB_POS:1}" == '}' ]]; then
        _JB_POS=$((_JB_POS + 1))
        return 0
    fi
    while :; do
        _jb_skip_ws
        if [[ "${_JB_JSON:_JB_POS:1}" != '"' ]]; then
            _jb_fail "对象的键必须是双引号字符串"
            return 1
        fi
        _jb_parse_string || return 1
        _jb_skip_ws
        if [[ "${_JB_JSON:_JB_POS:1}" != ':' ]]; then
            _jb_fail "对象的键后缺少 ':'"
            return 1
        fi
        _JB_POS=$((_JB_POS + 1))
        _jb_parse_value || return 1
        _jb_skip_ws

        local c="${_JB_JSON:_JB_POS:1}"
        case "$c" in
            ',')
                _JB_POS=$((_JB_POS + 1))
                _jb_skip_ws
                if [[ "${_JB_JSON:_JB_POS:1}" == '}' ]]; then
                    _jb_fail "对象结尾不允许尾随逗号"
                    return 1
                fi
                ;;
            '}')
                _JB_POS=$((_JB_POS + 1))
                return 0
                ;;
            '')
                _jb_fail "对象未闭合"
                return 1
                ;;
            *)
                _jb_fail "对象中意外的字符 '$c'"
                return 1
                ;;
        esac
    done
}

_jb_parse_array() {
    _JB_POS=$((_JB_POS + 1))
    _jb_skip_ws
    if [[ "${_JB_JSON:_JB_POS:1}" == ']' ]]; then
        _JB_POS=$((_JB_POS + 1))
        return 0
    fi
    while :; do
        _jb_parse_value || return 1
        _jb_skip_ws

        local c="${_JB_JSON:_JB_POS:1}"
        case "$c" in
            ',')
                _JB_POS=$((_JB_POS + 1))
                _jb_skip_ws
                if [[ "${_JB_JSON:_JB_POS:1}" == ']' ]]; then
                    _jb_fail "数组结尾不允许尾随逗号"
                    return 1
                fi
                ;;
            ']')
                _JB_POS=$((_JB_POS + 1))
                return 0
                ;;
            '')
                _jb_fail "数组未闭合"
                return 1
                ;;
            *)
                _jb_fail "数组中意外的字符 '$c'"
                return 1
                ;;
        esac
    done
}